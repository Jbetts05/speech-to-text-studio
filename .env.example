# Safe local defaults. The application does not load this file automatically.
AI_BENCH_RUNTIME=local
AI_BENCH_STATE_ROOT=.ai-bench
AI_BENCH_ALLOW_NETWORKED_SOLUTIONS=false
AI_BENCH_PUBLIC_DEMO_MODE=false

# Azure deployments set identity-based endpoints through AZD and Bicep.
# Never store provider keys or storage connection strings in this file.
# Hosted release explicitly selects AI_BENCH_EXECUTION_BACKEND=azure-table-blob.
# Current core selector AI_BENCH_STORAGE_BACKEND has the same explicit value.
# AI_BENCH_AZURE_NAMESPACE is a stable, deployment-selected Table partition.
# AI_BENCH_BACKEND_CONFORMANCE_RECEIPT must identify verified persisted proof.
# AI_BENCH_SPEECH_ENDPOINT, AI_BENCH_OPENAI_ENDPOINT and AI_BENCH_MAI_ENDPOINT
# come from existing accounts' ARM outputs, never inferred host names or tracked JSON.
