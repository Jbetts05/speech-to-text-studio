targetScope = 'subscription'

@minLength(1)
@description('AZD environment name used for deterministic resource naming.')
param environmentName string

@description('Azure region for newly created resources.')
param location string

@minLength(1)
@description('Existing selected resource group. This deployment never creates or retags a group.')
param existingResourceGroupName string

@allowed([
  'offline'
  'entra'
  'key'
])
@description('Provider authentication mode. Hosted deployments should use entra.')
param authMode string = 'entra'

@description('Subscription containing the reusable Foundry account.')
param foundrySubscriptionId string = subscription().subscriptionId

@description('Resource group containing the reusable Foundry account.')
param foundryResourceGroupName string = ''

@description('Reusable Foundry account name.')
param foundryAccountName string = ''

param maiSubscriptionId string = subscription().subscriptionId
param maiResourceGroupName string = ''
param maiAccountName string = ''
param gptTranscribeDeploymentName string = ''
param whisperDeploymentName string = ''

@description('Explicit public demo exception; defaults remain restricted/offline.')
param publicDemoMode bool = false
@description('Bounded operator CIDR; explicit empty selects Entra-only SCM only in Entra public-demo mode.')
param scmAllowedCidr string
@description('Explicit approval to update only the two existing accounts public network settings.')
param enableProviderPublicAccess bool = false
@description('Base64 frozen ARM read-back generated by prepare_environment, never a tracked fixture.')
param providerAccountSnapshotsBase64 string = 'e30='

@description('ARM endpoint map keys; empty selects the actual account endpoint, never an inferred URL.')
param speechEndpointKey string = ''
param openaiEndpointKey string = ''
param maiEndpointKey string = ''

@description('Content hash of the published backend attestation; runtime must verify the persisted proof.')
param backendConformanceAttestation string = ''
@minLength(3)
param keyVaultName string
@minLength(3)
param storageAccountName string
@minLength(1)
@maxLength(128)
param executionNamespace string = 'application-v1'

@description('Linux App Service plan SKU.')
param appServiceSku string = 'B1'

@description('Whether the application endpoint is public. Storage and Key Vault remain private.')
param enableAppPublicAccess bool = true

@description('Explicitly permit benchmark packs to invoke networked solutions.')
param allowNetworkedSolutions bool = false

@description('Optional operator IPv4 CIDR for main app ingress. SCM is configured independently.')
param ingressAllowedCidr string = ''

@description('Whether Azure Monitor ingestion and query endpoints allow public access.')
param enableMonitoringPublicAccess bool = true

@description('Whether the target App Service already exists and its settings must be preserved.')
param preserveExistingAppSettings bool = false

var normalizedEnvironmentName = take(
  replace(replace(toLower(environmentName), '_', '-'), ' ', '-'),
  36
)
var suffix = take(uniqueString(subscription().id, environmentName, location), 6)
var targetResourceGroupName = existingResourceGroupName
var appResourceGroupId = '${subscription().id}/resourceGroups/${targetResourceGroupName}'
var appName = 'app-${normalizedEnvironmentName}-${take(uniqueString(subscription().id, appResourceGroupId, normalizedEnvironmentName), 6)}'
var appResourceId = resourceId(subscription().subscriptionId, targetResourceGroupName, 'Microsoft.Web/sites', appName)
var foundryConfigured = !empty(foundryResourceGroupName) && !empty(foundryAccountName)
var maiConfigured = !empty(maiResourceGroupName) && !empty(maiAccountName)
var providerAccountSnapshots = json(base64ToString(providerAccountSnapshotsBase64))

module foundryInfo './modules/foundry-info.bicep' = if (foundryConfigured) {
  name: 'foundry-info-${suffix}'
  scope: resourceGroup(foundrySubscriptionId, foundryResourceGroupName)
  params: {
    accountName: foundryAccountName
    deploymentNames: filter([gptTranscribeDeploymentName, whisperDeploymentName], value => !empty(value))
  }
}

module maiInfo './modules/foundry-info.bicep' = if (maiConfigured) {
  name: 'mai-info-${suffix}'
  scope: resourceGroup(maiSubscriptionId, maiResourceGroupName)
  params: {
    accountName: maiAccountName
  }
}

module foundryPublicNetwork './modules/provider-public-network.bicep' = if (enableProviderPublicAccess && foundryConfigured && maiConfigured) {
  name: 'foundry-public-network-${suffix}'
  scope: resourceGroup(foundrySubscriptionId, foundryResourceGroupName)
  params: {
    preservedAccount: providerAccountSnapshots.accounts.primary.writable
    accountName: foundryAccountName
  }
  dependsOn: [
    foundryInfo
    maiInfo
  ]
}

module maiPublicNetwork './modules/provider-public-network.bicep' = if (enableProviderPublicAccess && foundryConfigured && maiConfigured) {
  name: 'mai-public-network-${suffix}'
  scope: resourceGroup(maiSubscriptionId, maiResourceGroupName)
  params: {
    preservedAccount: providerAccountSnapshots.accounts.secondary.writable
    accountName: maiAccountName
  }
  dependsOn: [
    foundryInfo
    maiInfo
  ]
}

module platform './modules/platform.bicep' = {
  name: 'platform-${suffix}'
  scope: resourceGroup(targetResourceGroupName)
  params: {
    name: normalizedEnvironmentName
    appName: appName
    location: location
    tags: {
      'azd-env-name': environmentName
    }
    authMode: authMode
    foundryEndpoint: foundryConfigured ? foundryInfo!.outputs.endpoint : ''
    appServiceSku: appServiceSku
    enableAppPublicAccess: enableAppPublicAccess
    allowNetworkedSolutions: allowNetworkedSolutions
    ingressAllowedCidr: ingressAllowedCidr
    enableMonitoringPublicAccess: enableMonitoringPublicAccess
    preserveExistingAppSettings: preserveExistingAppSettings
    publicDemoMode: publicDemoMode
    scmAllowedCidr: scmAllowedCidr
    backendConformanceAttestation: backendConformanceAttestation
    keyVaultName: keyVaultName
    storageAccountName: storageAccountName
    executionNamespace: executionNamespace
    enableProviderPublicAccess: enableProviderPublicAccess
    providerAppSettings: union(
      foundryConfigured ? {
        AI_BENCH_FOUNDRY_SUBSCRIPTION_ID: foundrySubscriptionId
        AI_BENCH_FOUNDRY_RESOURCE_GROUP: foundryResourceGroupName
        AI_BENCH_FOUNDRY_ACCOUNT: foundryAccountName
        AI_BENCH_SPEECH_ENDPOINT_KEY: speechEndpointKey
        AI_BENCH_OPENAI_ENDPOINT_KEY: openaiEndpointKey
        AI_BENCH_SPEECH_ENDPOINT: empty(speechEndpointKey) ? foundryInfo!.outputs.endpoint : foundryInfo!.outputs.endpoints[speechEndpointKey]
        AI_BENCH_OPENAI_ENDPOINT: empty(openaiEndpointKey) ? foundryInfo!.outputs.endpoint : foundryInfo!.outputs.endpoints[openaiEndpointKey]
      } : {},
      maiConfigured ? {
        AI_BENCH_MAI_SUBSCRIPTION_ID: maiSubscriptionId
        AI_BENCH_MAI_RESOURCE_GROUP: maiResourceGroupName
        AI_BENCH_MAI_ACCOUNT: maiAccountName
        AI_BENCH_MAI_ENDPOINT_KEY: maiEndpointKey
        AI_BENCH_MAI_ENDPOINT: empty(maiEndpointKey) ? maiInfo!.outputs.endpoint : maiInfo!.outputs.endpoints[maiEndpointKey]
      } : {},
      !empty(gptTranscribeDeploymentName) ? {
        AI_BENCH_GPT_TRANSCRIBE_DEPLOYMENT: foundryInfo!.outputs.deploymentNames[0]
      } : {},
      !empty(whisperDeploymentName) ? {
        AI_BENCH_WHISPER_DEPLOYMENT: last(foundryInfo!.outputs.deploymentNames)
      } : {}
    )
  }
  dependsOn: [
    foundryPublicNetwork
    maiPublicNetwork
  ]
}

module foundryAccess './modules/foundry-access.bicep' = if (authMode == 'entra' && foundryConfigured) {
  name: 'foundry-access-${suffix}'
  scope: resourceGroup(foundrySubscriptionId, foundryResourceGroupName)
  params: {
    accountName: foundryAccountName
    principalId: platform.outputs.appPrincipalId
    principalResourceId: appResourceId
  }
}

module maiAccess './modules/foundry-access.bicep' = if (authMode == 'entra' && maiConfigured) {
  name: 'mai-access-${suffix}'
  scope: resourceGroup(maiSubscriptionId, maiResourceGroupName)
  params: {
    accountName: maiAccountName
    principalId: platform.outputs.appPrincipalId
    principalResourceId: appResourceId
  }
}

output AZURE_RESOURCE_GROUP string = targetResourceGroupName
output AZURE_LOCATION string = location
output AI_BENCH_APP_NAME string = platform.outputs.appName
output AI_BENCH_APP_URL string = platform.outputs.appUrl
output AI_BENCH_APP_PRINCIPAL_ID string = platform.outputs.appPrincipalId
output AI_BENCH_STORAGE_ACCOUNT string = platform.outputs.storageAccountName
output AI_BENCH_KEY_VAULT_NAME string = platform.outputs.keyVaultName
output AI_BENCH_FOUNDRY_ENDPOINT string = foundryConfigured ? foundryInfo!.outputs.endpoint : ''
output AI_BENCH_FOUNDRY_SCOPE string = foundryConfigured ? foundryInfo!.outputs.accountId : ''
output AI_BENCH_MAI_SCOPE string = maiConfigured ? maiInfo!.outputs.accountId : ''
output AI_BENCH_MAI_ENDPOINT string = maiConfigured ? maiInfo!.outputs.endpoint : ''
output AI_BENCH_ARTIFACT_CONTAINER string = platform.outputs.artifactContainerName
output AI_BENCH_STAGING_CONTAINER string = platform.outputs.stagingContainerName
output AI_BENCH_STATE_TABLE string = platform.outputs.stateTableName
output AI_BENCH_VNET_ID string = platform.outputs.vnetId
output AI_BENCH_PRIVATE_ENDPOINT_SUBNET_ID string = platform.outputs.privateEndpointSubnetId
output AI_BENCH_PRIVATE_ENDPOINT_IDS array = platform.outputs.privateEndpointIds
